# Settings for the local production-image harness (docker-compose.yml).
# Copy to .env to change any of them -- every value has a working default,
# so `docker compose up --build` needs no .env at all.
#
# This file is NOT the configuration for a real deploy. On Railway these
# values are service variables; see README §9.

HTTP_PORT=8080

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Admin account created on first boot.
#
# admin/admin is fine here and ONLY here: init.sh's secrets guard rejects a
# default password whenever the site URL is not localhost, so these values
# cannot reach a public deploy even if copied there by accident.
CD_ADMIN_USER=admin
CD_ADMIN_PASSWORD=admin
CD_ADMIN_EMAIL=admin@example.com

# 1 locally to surface PHP notices; forced to 0 on a public deploy, where
# stack traces and file paths must never be served.
WORDPRESS_DEBUG=1

# auto  seed demo content only when the site has no courses (first boot)
# force reseed on every start -- DESTRUCTIVE, deletes hand-authored courses
# skip  never seed
CD_SEED=auto
